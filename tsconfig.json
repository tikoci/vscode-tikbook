{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": [
      "es2020",
      "WebWorker"
    ],
    "moduleResolution": "node",
    "sourceMap": true,
    "strict": false,
    "outDir": "./out",
    "rootDir": "./src",
    "incremental": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules/**",
    ".vscode-test"
  ]
}