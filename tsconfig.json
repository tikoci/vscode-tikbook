{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "lib": [
      "ES2017",
      "WebWorker"
    ],
    "moduleResolution": "node",
    "sourceMap": true,
    "strict": true,
    "outDir": "./out",
    "rootDir": "./src",
    "incremental": false,
    "esModuleInterop": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    ".vscode-test-web"
  ]
}