        "shortTitle": "MikroTik Help Menu",
        "category": "RouterOS",
        "icon": "$(question)"
      },
      {
        "command": "tikbook.view.markdown",
        "title": "View as Markdown",
        "shortTitle": "As Markdown",
        "category": "RouterOS",
        "icon": "$(markdown)"
      },
      {
        "command": "tikbook.markdown.reopen.notebook",
        "title": "Open as Markdown TikBook",
        "category": "TikBook",
        "icon": "$(tikoci-tikbook)"
      },
      {
        "command": "tikbook.view.script",
        "title": "View as RouterOS Script",
        "shortTitle": "View RouterOS Script",
        "category": "RouterOS",
        "icon": "$(mikrotik-icon-solid)"
      },
      {
        "command": "tikbook.open.terminal.router",
