        "shortTitle": "Copy as TikBook (.md)",
        "category": "RouterOS",
        "icon": "$(tikoci-tikbook)",
        "when": "(resourceExtname == .md || resourceLangId == markdown || editorLangId == markdown) && resourceScheme == rscena"
      },
      {
        "command": "tikbook.markdown.routeros.run.block",
        "title": "Run RouterOS code blocks in Markdown",
        "shortTitle": "Run RouterOS",
        "category": "RouterOS",
        "icon": "$(play)",
        "when": "resourceLangId == markdown || resourceExtname == .md || editorLangId == markdown"
      },
      {
        "command": "tikbook.notebook.clone.routeros",
        "title": "Copy As RouterOS TikBook",
        "category": "TikBook",
        "icon": "$(tikoci-tikbook)",
        "when": "false"
      },
      {
        "command": "tikbook.notebook.clone.markdown",
        "title": "Copy As Markdown RouterOS",
        "category": "TikBook",
        "icon": "$(markdown)",
        "when": "false"
      },
      {
        "command": "tikbook.show.menu.main",
        "title": "Quick Commander Menu",
        "shortTitle": "Commander",
        "category": "TikBook",
        "icon": "icon.png"
      },
      {
        "command": "tikbook.test.video.embedded",
        "title": "Show Help Video (Experimental)",
