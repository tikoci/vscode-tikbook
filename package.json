        "priority": "default"
      },
      {
        "type": "routeros",
        "displayName": "RouterOS Notebook",
        "icon": {
          "light": "icon.png",
          "dark": "icon.png"
        },
        "selector": [
          {}
        ],
        "priority": "option"
      },
      {
        "type": "markdown-routeros",
        "displayName": "Markdown RouterOS",
        "icon": {
          "light": "icon.png",
          "dark": "icon.png"
        },
        "selector": [
          {
            "filenamePattern": "*.rscmd"
          },
          {
            "filenamePattern": "*.rsc.md"
          }
        ],
        "priority": "default"
      }
    ],
    "customEditors": [
      {
        "viewType": "markdown-routeros",
        "displayName": "Markdown RouterOS",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "tikbook",
        "displayName": "RouterOS TikBook",
        "selector": [
          {
            "filenamePattern": "*.rsc"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "markdown",
        "displayName": "Markdown",
        "selector": [
          {
            "filenamePattern": "*.rscmd"
          }
        ],
        "priority": "option"
      }
