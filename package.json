      },
      {
        "command": "tikoci.secrets.default.clear",
        "title": "Disable Secret Password",
        "category": "TikBook",
        "icon": "$(clear-all)"
      },
      {
        "command": "tikbook.show.menu.variables.global",
        "title": "$(symbol-variable)  Insert :global Variable",
