        "icon": "$(symbol-variable)"
      },
      {
        "command": "tikbook.browse.mikrotikstatus",
        "title": "MikroTik Cloud Status (mikrotikstat.us)",
        "category": "MikroTik",
        "icon": "$(home)"
      },
      {
        "command": "tikbook.browse.tikoci.home",
        "title": "Browse Project Homepage",
        "category": "TIKOCI",
        "icon": "$(home)"
      },
      {
        "command": "tikbook.menu.showTikociRepoPicker",
        "title": "Browse GitHub Repository...",
        "category": "TIKOCI",
        "icon": "$(github)"
      },
      {
        "command": "tikbook.browse.mikrotik.forum",
        "title": "Browse Forum",
        "category": "MikroTik",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "tikbook.browse.mikrotik.issues",
        "title": "Bug Reporting",
        "category": "MikroTik",
        "icon": "$(bug)"
      },
      {
        "command": "tikbook.browse.mikrotik.docs.scripting",
        "title": "Scripting Help",
        "category": "MikroTik",
        "icon": "$(debug-continue)"
      },
      {
        "command": "tikbook.browse.mikrotik.docs",
        "title": "Documentation",
        "category": "MikroTik",
        "icon": "$(mikrotik-icon-line)"
      },
      {
        "command": "tikbook.vdoc.refresh.all",
        "title": "Refresh All Virtual Documents",
        "category": "TikBook",
        "icon": "$(refresh)"
      },
      {
        "command": "tikbook.vdoc.refresh.active",
        "title": "Refresh Current Virtual Document",
        "category": "TikBook",
        "icon": "$(refresh)"
      }
    ],
    "icons": {
      "mikrotik-icon-line": {
        "description": "MikroTik Line Icon",
        "default": {
          "fontCharacter": "",
          "fontPath": "./media/fonticon/mikrotik.woff2"
        }
      },
      "mikrotik-icon-solid": {
        "description": "MikroTik Solid Icon",
        "default": {
          "fontCharacter": "",
          "fontPath": "./media/fonticon/mikrotik.woff2"
        }
      },
      "mikrotik-logo-line": {
        "description": "MikroTik Solid Logo with Text",
        "default": {
          "fontCharacter": "",
          "fontPath": "./media/fonticon/mikrotik.woff2"
        }
      },
      "mikrotik-logo-solid": {
        "description": "MikroTik Line Logo with Text",
        "default": {
          "fontCharacter": "",
          "fontPath": "./media/fonticon/mikrotik.woff2"
        }
      },
      "tikoci-tikbook": {
        "description": "TIKOCI TikBook",
        "default": {
          "fontCharacter": "",
          "fontPath": "./media/fonticon/tikoci.woff2"
        }
      }
    }
  },
  "scripts": {
    "lint": "bun audit && eslint src/*.ts src/test/*.ts",
    "clean": "rm -rf ./out/* && rm -f *.vsix",
    "compile": "bun run compile:web && bun run compile:node",
    "compile:node": "bun build src/extension.ts --outdir=./out --entry-naming=extension-node.js --external vscode --format=cjs --target=node --sourcemap ",
    "compile:web": "bun build src/extension.ts --outdir=./out --entry-naming=extension-web.js --external vscode --format=cjs --target=browser --sourcemap",
    "typecheck": "tsc --noEmit",
    "bump:patch": "npm version patch",
    "compile:icons": "bun run compile:icons:tikoci && bun run compile:icons:mikrotik",
    "compile:icons:tikoci": "mkdir -p ./media/fonticon; npx fantasticon -t woff2 -g css --output ./media/fonticon --name tikoci ./media/svg/tikoci",
    "compile:icons:mikrotik": "mkdir -p ./media/fonticon; npx fantasticon -t woff2 -g css --output ./media/fonticon --name mikrotik ./media/svg/mikrotik",
    "compile:icons:all:ttf": "mkdir -p ./media/fonticon; npx fantasticon -t ttf -g html --output ./media/fonticon --name tikoci-all ./media/svg",
    "compile:test": "bun build src/test/*.test.ts --outdir=./out/test --external vscode --format=cjs --target=node --sourcemap",
    "vsix:package:all": "bun run vsix:package:node && && bun run vsix:package:web ",
    "vsix:package": "bun run vsix:package:node && bun run vsix:package:web",
    "vsix:package:node": "rm -f *-node.vsix && bun run compile && npx @vscode/vsce package --no-dependencies --pre-release -o tikbook-node.vsix",
    "vsix:package:web": "rm -f *-web.vsix && bun run compile && npx @vscode/vsce package --target web --no-dependencies --pre-release -o tikbook-web.vsix",
    "vsix:install": "bun run vsix:remove; bun run vsix:package && code --install-extension tikbook-*.vsix",
    "vsix:remove": "code --uninstall-extension tikoci.tikbook || echo '... well if not install, cannot remove it'",
    "vscode:prepublish": "bun run lint && bun run compile",
    "ovsx:publish": "npx ovsx publish tikbook-node.vsix -p $OVSX_PAT",
    "vsix:publish:node": "npx @vscode/vsce publish --packagePath ./tikbook-node.vsix --no-dependencies --pre-release -p $VSCE_PAT",
    "vsix:publish:web": "npx @vscode/vsce publish --target web --packagePath ./tikbook-web.vsix --no-dependencies --pre-release -p $VSCE_PAT",
    "watch:test": "bun build src/test/*.test.ts --outdir=./out/test --external vscode --format=cjs --target=node --sourcemap --watch",
    "watch:node": "bun build src/extension.ts --outdir=./out --entry-naming=extension-node.js --external vscode --format=cjs --target=node --sourcemap --watch",
    "pretest": "bun run compile:test",
    "test": "vscode-test",
    "test:ffmpeg": "ffmpeg -i in-aac.mp4 -c:v copy -c:a libmp3lame -q:a 0 out-mp3.mp4",
    "test:serve": "npx serve --cors -l 7474 --ssl-cert $HOME/.local/certs/localhost.pem --ssl-key $HOME/.local/certs/localhost-key.pem",
    "postinstall": ""
  },
