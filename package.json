{
  "name": "tikbook",
  "description": "Notebook and Tools for MikroTik RouterOS",
  "author": "AmmØ",
  "license": "MIT",
  "version": "0.3.2",
  "publisher": "TIKOCI",
  "categories": [
    "Notebooks",
    "Testing",
    "Programming Languages",
    "Education"
  ],
  "displayName": "TikBook for RouterOS",
  "icon": "icon.png",
  "keywords": [
    "routeros",
    "mikrotik",
    "lsp",
    "rsc",
    "tikoci",
    "notebook",
    "literate",
    "tikbook",
    "vscode",
    "vscode-extension",
    "notebookKernelTikbook",
    "notebookKernelMarkdownRouteros",
    "notebookKernelInteractiveTikbook",
    "notebookKernelRouteros"
  ],
  "preview": true,
  "pricing": "Free",
  "sponsor": {
    "url": "https://coff.ee/amm0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tikoci/vscode-tikbook.git"
  },
  "bugs": {
    "url": "https://github.com/tikoci/vscode-tikbook/issues"
  },
  "qna": "https://github.com/orgs/tikoci/discussions/categories/q-a",
  "homepage": "https://github.com/tikoci/vscode-tikbook/blob/main/README.md",
  "engines": {
    "vscode": "^1.78.2"
  },
  "browser": "./out/extension-web.js",
  "main": "./out/extension-node.js",
  "funding": [
    "https://coff.ee/amm0"
  ],
  "extensionPack": [
    "TIKOCI.lsp-routeros-ts"
  ],
  "activationEvents": [
    "onNotebook:tikbook",
    "onNotebook:markdown-routeros",
    "onNotebook:interactive",
    "onNotebook:routeros",
    "onLanguage:routeros",
    "onLanguage:markdown",
    "onFileSystem:systemscriptfs"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tikbook",
        "extensions": [
          ".tikbook",
          ".md.rsc"
        ],
        "firstLine": "#!tikbook.*",
        "filenamePatterns": [
          "*.tikbook.rsc",
          "*.md.rsc"
        ],
        "icon": {
          "light": "icon.png",
          "dark": "icon.png"
        },
        "aliases": [
          "TikBook",
          "tikbook"
        ]
      },
      {
        "id": "markdown",
        "extensions": [
          "*.rscmd"
        ]
      },
      {
        "id": "markdown-routeros",
        "firstLine": ".*#!tikbook.*",
        "filenamePatterns": [
          "*.rscmd",
          "*.rsc.md"
        ],
        "icon": {
          "light": "icon.png",
          "dark": "icon.png"
        },
        "aliases": [
          "Markdown RouterOS",
          "Markdown",
          "markdown"
        ]
      }
    ],
    "keybindings": [
      {
        "command": "tikbook.show.menu.main",
        "key": "shift+alt+m"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "TikBook for RouterOS",
      "properties": {
        "tikbook.baseUrl": {
          "scope": "application",
          "type": "string",
          "default": "http://192.168.88.1",
          "description": "Set the host and protocol to connect to RouterOS.",
          "order": 1,
          "examples": [
            "http://192.0.2.0",
            "https://portsok.example.com:8443"
          ]
        },
        "tikbook.username": {
          "scope": "application",
          "type": "string",
          "default": "admin",
          "description": "Username to use when TikBook connects to a RouterOS device",
          "order": 2
        },
        "tikbook.password": {
          "scope": "application",
          "type": "string",
          "markdownDeprecationMessage": "Settings are stored plain text.  Instead, REST API password should use VSCode's SecretStorage instead.  [Store Password as Secret](command:tikoci.secrets.default.set)",
          "markdownDescription": "Password to use when TikBook connects to a RouterOS device.  _Only used if a secret is not set._",
          "order": 3,
          "when": "tikbook.usingSecrets === false"
        },
        "tikbook.passwordInfo": {
          "scope": "application",
          "type": "string",
          "markdownDescription": "The RouterOS password should be stored in \"secrets\".  **Use [Store Password as Secret](command:tikoci.secrets.default.set) to set RouterOS password.**  _Or, [Clear Password Secret](command:tikoci.secrets.default.clear) to use plain text 'password' from VSCode Settings._",
          "default": "❓ initializing",
          "order": 4
        },
        "tikbook.apiTimeout": {
          "scope": "application",
          "type": "number",
          "default": 30,
          "maximum": 60,
          "minimum": 5,
          "description": "How long a command sent to RouterOS waits for a response before giving up",
          "order": 6
        },
        "tikbook.sshCommand": {
          "scope": "application",
          "type": "string",
          "default": "ssh",
          "markdownDescription": "`ssh` Command (and any path or arguments) to with Terminal.  _Do not include the username/host or command parts_",
          "order": 7
        },
        "tikbook.checkCertificates": {
          "scope": "application",
          "type": "boolean",
          "default": false,
          "order": 5,
          "markdownDescription": "When using `https`, whether to check if router certificate is locally trusted.  This setting has **no effect** _unless_ [`http.proxySupport`](command:workbench.action.openSettings?%5B%22http.proxySupport%22%5D) ([Help: Proxy Support]((command:workbench.action.openSettings?%5B%22http.proxySupport%22%5D))) [setting](command:workbench.action.openSettings?%5B%22http.proxySupport%22%5D) is **_fallback_** or **_off_**.  The `http.proxySupport` default of _override_ does not allow certificate checks to be disabled.  _In VS Code for the Web, a trusted certificate is always required and cannot be disabled._"
        },
        "tikbook.provideLspServerCredentials": {
          "scope": "application",
          "type": "boolean",
          "default": true,
          "markdownDescription": "When enabled, TikBook's credentials will 'override' RouterOS LSP's credentials.  _Note: RouterOS LSP [Allow Client Provided Credentials](command:workbench.action.openSettings?%5B%22routeroslsp.allowClientProvidedCredentials%22%5D) Setting must be enabled, otherwise TikBook credentials are ignored._",
          "order": 6
        }
      }
    },
    "menus": {
      "file/newFile": [
        {
          "command": "tikbook.new.notebook.repl",
          "group": "notebook",
          "icon": "$(terminal)"
        },
        {
          "command": "tikbook.new.notebook",
          "group": "notebook",
          "icon": "icon.png"
        },
        {
          "command": "tikbook.new.notebook.markdown",
          "group": "notebook",
          "icon": "$(markdown)"
        },
        {
          "command": "tikbook.new.notebook.router.scripts",
          "group": "notebook",
          "icon": "$(mikrotik-icon-line)"
        }
      ],
      "explorer/context": [
        {
          "command": "tikbook.fn.copyJsonAsRouterArray",
          "group": "7_cutcopypaste",
          "icon": "$(symbol-array)",
          "when": "resourceLangId == json || resourceLangId == jsonc || editorLangId == json || editorLangId == jsonc"
        },
        {
          "command": "tikbook.notebook.clone.routeros",
          "group": "7_cutcopypaste",
          "icon": "$(tikoci-tikbook)",
          "when": "explorerResourceAvailableEditorIds =~ /markdown-routeros/"
        },
        {
          "command": "tikbook.notebook.clone.markdown",
          "group": "7_cutcopypaste",
          "icon": "$(markdown)",
          "when": "explorerResourceAvailableEditorIds =~ /tikbook/"
        }
      ],
      "editor/context": [
        {
          "command": "tikbook.fn.copyJsonAsRouterArray",
          "group": "9_cutcopypaste@3",
          "icon": "$(symbol-array)",
          "when": "resourceLangId == json || resourceLangId == jsonc || editorLangId == json || editorLangId == jsonc"
        },
        {
          "command": "tikbook.convert.escapedRouterString.clipboard",
          "group": "9_cutcopypaste@3",
          "icon": "$(symbol-string)",
          "when": "textInputFocus"
        },
        {
          "command": "tikbook.vdoc.refresh.active",
          "group": "navigation",
          "icon": "$(refresh)",
          "when": "resourceScheme == rscena"
        },
        {
          "command": "tikbook.browse.mikrotik.help",
          "group": "z_help",
          "icon": "$(question)",
          "when": "resourceScheme == rscena || resourceLangId == routeros || resourceLangId == markdown || editorLangId == routeros"
        }
      ],
      "editor/title": [
        {
          "command": "tikbook.view.markdown",
          "group": "navigation",
          "icon": "$(open-preview)",
          "when": "notebookType == tikbook || notebookType == routeros || (resourceLangId == routeros || resourceExtname == .rsc)"
        },
        {
          "command": "tikbook.view.script",
          "group": "navigation",
          "icon": "$(mikrotik-icon-solid)",
          "when": "notebookType == markdown-routeros"
        },
        {
          "command": "tikbook.markdown.reopen.notebook",
          "group": "navigation@1",
          "icon": "$(tikoci-tikbook)",
          "when": "resourceScheme == file && (resourceLangId == markdown-routeros || resourceLangId == markdown || resourceExtname == .md || resourceExtname == .rscmd) && notebookType != markdown-routeros"
        },
        {
          "command": "tikbook.routeros.reopen.notebook.routeros",
          "group": "navigation@1",
          "icon": "$(tikoci-tikbook)",
          "when": "!notebookType && resourceScheme == file && (resourceLangId == routeros || resourceExtname == .rsc || editorLangId == routeros)"
        },
        {
          "command": "tikbook.vdoc.clone.tikbook",
          "group": "navigation@1",
          "icon": "$(tikoci-tikbook)",
          "when": "resourceScheme == rscena && (resourceLangId == routeros || editorLangId == routeros)"
        },
        {
          "command": "tikbook.vdoc.clone.markdown",
          "group": "navigation@1",
          "icon": "$(tikoci-tikbook)",
          "when": "resourceScheme == rscena && (resourceLangId == markdown || editorLangId == markdown || resourceExtname == .md)"
        },
        {
          "command": "tikbook.notebook.reopen.routeros",
          "group": "navigation@1",
          "icon": "$(mikrotik-icon-line)",
          "when": "notebookType == tikbook || notebookType == routeros"
        },
        {
          "command": "tikbook.fn.copyJsonAsRouterArray",
          "group": "navigation@1",
          "icon": "$(symbol-array)",
          "when": "resourceLangId == json || resourceLangId == jsonc || editorLangId == json || editorLangId == jsonc"
        },
        {
          "command": "tikbook.notebook.markdown.preview.markdown",
          "group": "navigation",
          "when": "notebookType == markdown-routeros && resourceScheme == file || resourceExtname == rscmd || resourceLangId == markdown-routeros",
          "icon": "$(open-preview)"
        },
        {
          "command": "tikbook.vdoc.refresh.active",
          "group": "navigation",
          "icon": "$(refresh)",
          "when": "resourceScheme == rscena"
        }
      ],
      "notebook/cell/execute": [],
      "notebook/cell/title": [],
      "notebook/toolbar": [
        {
          "command": "tikbook.notebook.clone.routeros",
          "group": "inline",
          "when": "notebookType == markdown-routeros",
          "icon": "$(arrow-swap)"
        },
        {
          "command": "tikbook.notebook.clone.markdown",
          "group": "inline",
          "when": "notebookType == tikbook || notebookType == routeros",
          "icon": "$(arrow-swap)"
        }
      ]
    },
    "notebooks": [
      {
        "type": "tikbook",
        "displayName": "RouterOS TikBook",
        "icon": {
          "light": "icon.png",
          "dark": "icon.png"
        },
        "selector": [
          {
            "filenamePattern": "*.tikbook"
          },
          {
            "filenamePattern": "*.tikbook.rsc"
          },
          {
            "filenamePattern": "*.md.rsc"
          }
        ],
        "priority": "default"
      },
      {
        "type": "routeros",
        "displayName": "RouterOS Notebook",
        "icon": {
          "light": "icon.png",
          "dark": "icon.png"
        },
        "selector": [
          {}
        ],
        "priority": "option"
      },
      {
        "type": "markdown-routeros",
        "displayName": "Markdown RouterOS",
        "icon": {
          "light": "icon.png",
          "dark": "icon.png"
        },
        "selector": [
          {
            "filenamePattern": "*.rscmd"
          },
          {
            "filenamePattern": "*.rsc.md"
          }
        ],
        "priority": "default"
      }
    ],
    "customEditors": [
      {
        "viewType": "markdown-routeros",
        "displayName": "Markdown RouterOS",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "tikbook",
        "displayName": "RouterOS TikBook",
        "selector": [
          {
            "filenamePattern": "*.rsc"
          }
        ],
        "priority": "option",
        "icon": "icon.png"
      },
      {
        "viewType": "markdown",
        "displayName": "Markdown",
        "selector": [
          {
            "filenamePattern": "*.rscmd"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "tikbook.browse.mikrotik.help",
        "title": "RouterOS Help Resources...",
        "shortTitle": "MikroTik Help Menu",
        "category": "RouterOS",
        "icon": "$(question)"
      },
      {
        "command": "tikbook.view.markdown",
        "title": "View as Markdown",
        "shortTitle": "As Markdown",
        "category": "RouterOS",
        "icon": "$(markdown)"
      },
      {
        "command": "tikbook.view.script",
        "title": "View as RouterOS Script",
        "shortTitle": "View RouterOS Script",
        "category": "RouterOS",
        "icon": "$(mikrotik-icon-solid)"
      },
      {
        "command": "tikbook.open.terminal.router",
        "title": "Open SSH Terminal to Connected Router",
        "shortTitle": "Open SSH",
        "category": "RouterOS",
        "icon": "$(remote)"
      },
      {
        "command": "tikbook.new.notebook",
        "title": "Create Notebook for RouterOS",
        "category": "TikBook",
        "icon": "icon.png"
      },
      {
        "command": "tikbook.new.notebook.repl",
        "title": "Start Interactive REPL",
        "category": "TikBook",
        "icon": "$(terminal)"
      },
      {
        "command": "tikbook.new.notebook.markdown",
        "title": "Create Notebook for Markdown",
        "category": "TikBook",
        "icon": "$(markdown)"
      },
      {
        "command": "tikbook.new.notebook.router.scripts",
        "title": "New Notebook from System Scripts",
        "category": "TikBook",
        "icon": "$(mikrotik-icon-line)"
      },
      {
        "command": "tikbook.notebook.reopen.routeros",
        "title": "Open as RouterOS Script File",
        "category": "TikBook",
        "icon": "$(mikrotik-icon-line)",
        "when": "notebookType == tikbook || notebookType == routeros"
      },
      {
        "command": "tikbook.routeros.reopen.notebook.routeros",
        "title": "Open as RouterOS TikBook Notebook",
        "shortTitle": "Open as TikBook",
        "category": "RouterOS",
        "icon": "$(tikoci-tikbook)",
        "when": "!notebookType && resourceScheme != rscena && (resourceLangId == routeros || resourceExtname == .rsc || editorLangId == routeros)"
      },
      {
        "command": "tikbook.markdown.reopen.notebook",
        "title": "Open as Markdown RouterOS Notebook",
        "shortTitle": "Open as Notebook",
        "category": "Markdown",
        "icon": "$(markdown)",
        "when": "resourceScheme == file && (resourceLangId == markdown-routeros || resourceLangId == markdown || resourceExtname == .md || resourceExtname == .rscmd) && notebookType != markdown-routeros"
      },
      {
        "command": "tikbook.notebook.markdown.preview.markdown",
        "title": "Markdown Preview",
        "shortTitle": "Preview",
        "when": "notebookType == markdown-routeros || resourceExtname == rscmd || resourceLangId == markdown-routeros",
        "icon": "$(open-preview)"
      },
      {
        "command": "tikbook.vdoc.clone.tikbook",
        "title": "Copy as RouterOS TikBook Notebook",
        "shortTitle": "Copy as TikBook (.rsc)",
        "category": "RouterOS",
        "icon": "$(tikoci-tikbook)",
