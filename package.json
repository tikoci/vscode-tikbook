        "category": "TikBook",
        "icon": "$(output)"
      },
      {
        "command": "tikbook.fn.copyJsonAsRouterArray",
        "title": "Copy as RouterOS Array",
        "category": "RouterOS",
        "icon": "$(symbol-array)",
        "when": "resourceLangId == json || resourceLangId == jsonc || editorLangId == json || editorLangId == jsonc"
      },
      {
        "command": "tikbook.convert.escapedRouterString.clipboard",
        "title": "Copy as RouterOS String",
        "category": "RouterOS",
        "icon": "$(symbol-string)",
        "when": "textInputFocus"
      },
      {
        "command": "tikbook.open.router.export",
        "title": "Show current RouterOS :export",
        "shortTitle": ":export",
        "category": "RouterOS",
        "icon": "$(export)"
      },
      {
        "command": "tikbook.open.router.default-configuration.script",
        "title": "Show RouterOS /system/default-configuration",
        "shortTitle": "RouterOS defconf",
        "category": "RouterOS",
        "icon": "$(file-code)"
      },
      {
        "command": "tikbook.open.router.default-configuration.caps-mode-script",
        "title": "Show RouterOS /system/default-configuration (CAPsMAN)",
        "shortTitle": "RouterOS defconf-capsman",
        "category": "RouterOS",
        "icon": "$(file-code)"
      },
      {
        "command": "tikbook.open.router.default-configuration.custom",
        "title": "Show RouterOS /system/default-configuration (Custom)",
        "shortTitle": "RouterOS defconf-custom",
        "category": "RouterOS",
        "icon": "$(file-code)"
      },
      {
