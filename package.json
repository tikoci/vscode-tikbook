        "default": {
          "fontCharacter": "",
          "fontPath": "./media/fonticon/tikoci.woff2"
        }
      }
    }
  },
  "config": {
    "prereleaseflag": "--pre-release",
    "releaseflag": "--pre-release"
  },
  "scripts": {
    "vscode:prepublish": "npm run markdown:lint:public && npm run lint && npm run compile",
    "compile": "npm run clean && npm run lint && npm run typecheck && npm run compile:node",
    "compile:node": "bun build src/extension.ts --outdir=./out --entry-naming=extension.js --external vscode --format=cjs --target=node --sourcemap",
    "compile:web": "bun build src/extension.ts --outdir=./dist --entry-naming=extension.js --external vscode --format=cjs --target=browser --sourcemap",
    "compile:test": "rm -rf out/test && bun build src/test/unit/*.test.ts --outdir=out/test/unit --external vscode --format=cjs --target=node --sourcemap && bun build src/test/integration/*.test.ts --outdir=out/test/integration --root=src/test/integration --external vscode --format=cjs --target=node --sourcemap",
    "pretest": "npm run compile:node && npm run compile:test",
    "test": "vscode-test --config .vscode-test-cli.mjs",
    "pretest:web": "npm run compile:web && npm run compile:test",
    "test:web": "vscode-test --config .vscode-test-cli.mjs --browser",
    "lint": "eslint src --ext ts --fix",
    "lint:tools": "eslint tools --ext js,mjs --fix",
    "lint:all": "npm run lint && npm run lint:tools",
    "markdown:lint:public": "markdownlint-cli2 'README.md' 'CHANGELOG.md'",
    "markdown:lint:agentic": "markdownlint-cli2 'ROADMAP.md' 'DEVELOPMENT.md' 'docs/**/*.md'",
    "markdown:lint:all": "npm run markdown:lint:public && npm run markdown:lint:agentic",
    "markdown:lint": "npm run markdown:lint:agentic",
    "markdown:fix:public": "markdownlint-cli2 --fix 'README.md' 'CHANGELOG.md'",
    "markdown:fix:agentic": "markdownlint-cli2 --fix 'ROADMAP.md' 'DEVELOPMENT.md' 'docs/**/*.md'",
    "markdown:fix:all": "npm run markdown:fix:public && npm run markdown:fix:agentic",
    "markdown:fix": "npm run markdown:fix:agentic",
    "format": "npm run lint:all && npm run markdown:fix:all",
    "vsix:package:all": "npm run vsix:package:node && npm run vsix:package:web",
    "vsix:package": "npm run vsix:package:node && npm run vsix:package:web",
    "vsix:package:node": "rm -f *-node.vsix && npm run compile && npx @vscode/vsce package $npm_package_config_releaseflag -o tikbook-node.vsix",
    "vsix:package:web": "rm -f *-web.vsix && npm run clean && npm run lint && npm run compile:web && npx @vscode/vsce package --target web $npm_package_config_releaseflag -o tikbook-web.vsix",
    "vsix:install": "npm run vsix:remove; npm run vsix:package && code --install-extension tikbook-*.vsix",
    "vsix:remove": "code --uninstall-extension tikoci.tikbook || echo '... well if not install, cannot remove it'",
    "vsix:serve": "npm run vsix:package:web && rm -rf .vsix-serve && unzip -q tikbook-web.vsix -d .vsix-serve && npx serve@latest --cors .vsix-serve/extension -l 5000 --ssl-cert $HOME/certs/localhost.pem --ssl-key $HOME/certs/localhost-key.pem",
    "vsix:publish:node": "npx @vscode/vsce publish --packagePath ./tikbook-node.vsix $npm_package_config_releaseflag -p $VSCE_PAT",
    "vsix:publish:web": "npx @vscode/vsce publish --target web --packagePath ./tikbook-web.vsix $npm_package_config_releaseflag -p $VSCE_PAT",
    "ovsx:publish": "npx ovsx publish tikbook-node.vsix -p $OVSX_PAT",
    "package": "npm run compile && npx @vscode/vsce package",
    "package:web": "npm run compile && npx @vscode/vsce package --target web",
    "bump:patch": "npm version patch",
    "compile:icons": "npm run compile:icons:tikoci && npm run compile:icons:mikrotik",
    "compile:icons:tikoci": "mkdir -p ./media/fonticon; npx fantasticon -t woff2 -g css --output ./media/fonticon --name tikoci ./media/svg/tikoci",
    "compile:icons:mikrotik": "mkdir -p ./media/fonticon; npx fantasticon -t woff2 -g css --output ./media/fonticon --name mikrotik ./media/svg/mikrotik",
    "compile:icons:all:ttf": "mkdir -p ./media/fonticon; npx fantasticon -t ttf -g html --output ./media/fonticon --name tikoci-all ./media/svg",
    "outputenv": "node -e 'console.log(process.env)' | grep npm",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf out",
    "clean:all": "npm run clean && rm -rf dist *.vsix .vsix-serve",
    "clean:srcjs": "rm -rf src/*.js src/*.map",
    "serve": "npx serve@latest --cors --listen 3000",
    "serve:https": "npx serve@latest --cors -l 5000 --ssl-cert $HOME/certs/localhost.pem --ssl-key $HOME/certs/localhost-key.pem"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "luxon": "^3.7.2",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.79",
    "brace-expansion": "5.0.3",
    "eslint": "^10.0.1",
    "markdownlint-cli2": "^0.21.0",
    "minimatch": "10.2.4",
    "mocha": "^10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "peerDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "@types/vscode": "^1.109.0"
  },
  "private": false
}
