        "category": "RouterOS",
        "icon": "$(remote)"
      },
      {
        "command": "tikbook.mount.system.scripts",
        "title": "Mount RouterOS System Scripts",
        "category": "RouterOS",
        "icon": "$(plug)"
      },
      {
        "command": "tikbook.welcome.open.scriptfs",
        "title": "Open RouterOS System Scripts",
