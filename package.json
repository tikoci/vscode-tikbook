        "icon": "$(terminal)"
      },
      {
        "command": "tikbook.new.notebook.markdown",
        "title": "Create Notebook for Markdown",
        "category": "TikBook",
        "icon": "$(markdown)"
      },
      {
        "command": "tikbook.new.notebook.router.scripts",
        "title": "New Notebook from System Scripts",
