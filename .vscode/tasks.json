// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "compile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$tsc"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"type": "npm",
			"script": "compile:test",
			"group": "build",
			"problemMatcher": [
				"$tsc"
			],
			"presentation": {
				"reveal": "silent"
			}
		},
		{
			"label": "test-build",
			"dependsOn": [
				"compile",
				"compile:test"
			],
			"group": "build",
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent"
			}
		}
	]
}