{
    "cSpell.words": [
        "blackhole",
        "changeme",
        "checkin",
        "datatypes",
        "hotlock",
        "langserver",
        "mikropkl",
        "mikrotik",
        "Mikrotikls",
        "nexthops",
        "routeroslsp",
        "scalearr",
        "scriptname",
        "Tikbook",
        "webfig"
    ],
    "editor.tabSize": 2,
    "editor.stickyTabStops": false,
    "chat.tools.terminal.autoApprove": {
        "bun": true,
        "timeout": true,
        "true": true,
        "npm": true
    },
    
    // ============================================
    // ESLint Configuration (using flat config)
    // ============================================
    "eslint.enable": true,
    "eslint.run": "onSave",
    "eslint.format.enable": true,
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    
    // VS Code specific formatter integration
    "[javascript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.organizeImports": "explicit"
        }
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },
    "[typescript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.organizeImports": "explicit"
        }
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },
    
    // Capture deprecation warnings and other issues
    "problems.showCurrentInStatus": true,
    "problems.autoReveal": true
}