{
    "cSpell.words": [
        "blackhole",
        "changeme",
        "checkin",
        "datatypes",
        "hotlock",
        "langserver",
        "mikropkl",
        "mikrotik",
        "Mikrotikls",
        "nexthops",
        "routeroslsp",
        "scalearr",
        "scriptname",
        "Tikbook",
        "webfig"
    ],
    "editor.tabSize": 2,
    "editor.stickyTabStops": false,
    "chat.tools.terminal.autoApprove": {
        "bun": true,
        "timeout": true,
        "true": true,
        "npm": true,
        "npx tsc": true,
        "biome": true,
        "osascript": true,
        "mv": true
    },
    
    // ============================================
    // Biome Configuration
    // ============================================
    "biome.enabled": true,
    
    // VS Code specific linter integration (formatter disabled in biome.json)
    "[javascript]": {
        "editor.codeActionsOnSave": {
            "quickfix.biome": "explicit"
        }
    },
    "[javascriptreact]": {
        "editor.codeActionsOnSave": {
            "quickfix.biome": "explicit"
        }
    },
    "[typescript]": {
        "editor.codeActionsOnSave": {
            "quickfix.biome": "explicit"
        }
    },
    "[typescriptreact]": {
        "editor.codeActionsOnSave": {
            "quickfix.biome": "explicit"
        }
    },

    // Extension Test Runner discovery configuration
    "extension-test-runner.extractSettings": {
        "extractWith": "syntax",
        "suite": ["describe", "suite"],
        "test": ["it", "test"]
    },
    
    // Capture deprecation warnings and other issues
    "problems.showCurrentInStatus": true,
    "problems.autoReveal": true
}