# Source files
src/**
**/*.ts

# Build configuration
# Note: Do not add out/ or dist/ here - vsce automatically excludes build outputs
# that arent in package.json main/browser entry points
tsconfig.json
tsconfig.tsbuildinfo
eslint.config.mjs
.eslintrc.json

# Test files and infrastructure
test*
tests
**/tests
out/test/**
.vscode-test/**
.vscode-test.mjs
.vscode-test-cli.mjs
mocha-ai-reporter.cjs

# Development documentation
docs/**
DEVELOPMENT.md
.github/**

# Examples
examples/**

# Build tools
tools/**

# Markdown linting
.markdownlint.yaml
.markdownlint-agentic.yaml
.markdownlint-strict.yaml

# Development artifacts
.vscode/**
.scratch/**
.vsix-serve/**
.env.example
.sarbsettings*
package-lock.json
package*.json-save*
bun.lock
*.code-workspace
*.backup
*-backup*

