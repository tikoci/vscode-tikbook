{
	"$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"src/**/*.ts",
			"scripts/**/*.ts",
			"tools/**/*.mjs",
			"*.{ts,js,mjs}"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "warn",
				"useConst": "error",
				"useImportType": "warn",
				"useThrowOnlyError": "warn"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noDoubleEquals": "error",
				"noConsole": "warn",
				"useIterableCallbackReturn": "off"
			},
			"complexity": {
				"noForEach": "off",
				"useOptionalChain": "warn"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["scripts/**", "tools/**", "*.{js,mjs}"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["src/test/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"noExplicitAny": "warn"
					},
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		}
	]
}
